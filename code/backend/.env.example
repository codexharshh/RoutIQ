# Copy to .env for a new development environment; set a private, strong secret.
DJANGO_SECRET_KEY=
PRE_URL=

# Optional Supabase PostgreSQL Session Pooler connection. Leave blank to use local SQLite.
# Set this in your private .env using the Session Pooler URI copied from Supabase.
# The application enforces SSL and a short connection timeout for this URL.
DATABASE_URL=

# Keep disabled until the local model is configured.
ROUTIQ_DETECTOR_BACKEND=disabled

# Optional hosted road-damage inference. Never commit a real API key.
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=road-damages-detection/1
ROBOFLOW_API_URL=https://detect.roboflow.com
ROUTIQ_MODEL_WEIGHTS=
ROUTIQ_CONFIDENCE_THRESHOLD=0.25
ROUTIQ_DETECTOR_DEVICE=cpu

# Django -> local FastAPI vision service (not a public endpoint)
ROUTIQ_VISION_URL=http://127.0.0.1:8100
ROUTIQ_VISION_TIMEOUT=120

# Optional image evidence is stored privately and expires after 30 days by default.
ROUTIQ_PRIVATE_EVIDENCE_ROOT=
ROUTIQ_EVIDENCE_RETENTION_DAYS=30

# Production-only settings. Replace these example values before deployment.
DJANGO_ALLOWED_HOSTS=example.org
DJANGO_CORS_ALLOWED_ORIGINS=https://example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.org
DJANGO_SECURE_SSL_REDIRECT=true
# Production requires a private random DJANGO_SECRET_KEY of at least 50 characters.
