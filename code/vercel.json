{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://routiq-cqn1.onrender.com/api/:path*"
    },
    {
      "source": "/gov-api/:path*",
      "destination": "https://routiq-cqn1.onrender.com/gov-api/:path*"
    },
    {
      "source": "/accounts/:path*",
      "destination": "https://routiq-cqn1.onrender.com/accounts/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://routiq-cqn1.onrender.com/media/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
