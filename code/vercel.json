{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/auth/login/",
      "destination": "https://routiq-cqn1.onrender.com/api/v1/auth/login/"
    },
    {
      "source": "/api/v1/auth/register/",
      "destination": "https://routiq-cqn1.onrender.com/api/v1/auth/register/"
    },
    {
      "source": "/api/v1/auth/token/refresh/",
      "destination": "https://routiq-cqn1.onrender.com/api/v1/auth/token/refresh/"
    },
    {
      "source": "/api/v1/auth/profile/",
      "destination": "https://routiq-cqn1.onrender.com/api/v1/auth/profile/"
    },
    {
      "source": "/api/potholes/stats/",
      "destination": "https://routiq-cqn1.onrender.com/api/potholes/stats/"
    },
    {
      "source": "/api/potholes/",
      "destination": "https://routiq-cqn1.onrender.com/api/potholes/"
    },
    {
      "source": "/api/road-health/",
      "destination": "https://routiq-cqn1.onrender.com/api/road-health/"
    },
    {
      "source": "/api/road-health/:path*",
      "destination": "https://routiq-cqn1.onrender.com/api/road-health/:path*"
    },
    {
      "source": "/api/contractor-messages/:path*",
      "destination": "https://routiq-cqn1.onrender.com/api/contractor-messages/:path*"
    },
    {
      "source": "/api/v1/road-observations/:path*",
      "destination": "https://routiq-cqn1.onrender.com/api/v1/road-observations/:path*"
    },
    {
      "source": "/api/upload-videos/",
      "destination": "https://routiq-cqn1.onrender.com/api/upload-videos/"
    },
    {
      "source": "/api/upload-gps/",
      "destination": "https://routiq-cqn1.onrender.com/api/upload-gps/"
    },
    {
      "source": "/api/process-video/",
      "destination": "https://routiq-cqn1.onrender.com/api/process-video/"
    },
    {
      "source": "/api/cleanup-uploads/",
      "destination": "https://routiq-cqn1.onrender.com/api/cleanup-uploads/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://routiq-cqn1.onrender.com/api/:path*"
    },
    {
      "source": "/gov-api/:path*",
      "destination": "https://routiq-cqn1.onrender.com/gov-api/:path*"
    },
    {
      "source": "/accounts/:path*",
      "destination": "https://routiq-cqn1.onrender.com/accounts/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://routiq-cqn1.onrender.com/media/:path*"
    },
    {
      "source": "/((?!api/|gov-api/|accounts/|media/).*)",
      "destination": "/index.html"
    }
  ]
}
